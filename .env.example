# ==========================================
# AI Short Drama Studio - Environment Variables
# ==========================================
# Copy this file to .env and fill in your values
# ==========================================

# ---------- Application ----------
APP_NAME=AI Short Drama Studio
APP_VERSION=0.1.0
DEBUG=true
# Production requires an explicit SECRET_KEY (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-secret-key
ENVIRONMENT=development

# ---------- Database ----------
# DATABASE_TYPE: "sqlite" (default) or "postgres"
DATABASE_TYPE=sqlite
# SQLite file path (relative to backend/)
DATABASE_PATH=data/app.db

# PostgreSQL (only used when DATABASE_TYPE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_drama_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# ---------- Redis / Celery ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]

# ---------- Storage ----------
# STORAGE_TYPE: "local" (default) or "minio"
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=data/uploads

# MinIO (only used when STORAGE_TYPE=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ai-drama-studio-assets
MINIO_USE_SSL=false

# ---------- AI Service APIs (Agnes AI) ----------
# Get your key at: https://platform.agnes-ai.com/settings/apiKeys
AGNES_API_KEY=
AGNES_API_BASE=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0

# ---------- FFmpeg ----------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FORMAT=json
