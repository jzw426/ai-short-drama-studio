# ==========================================
# AI Short Drama Studio - Environment Variables
# ==========================================
# Copy this file to .env and fill in your values
# ==========================================

# ---------- Application ----------
APP_NAME=AI Short Drama Studio
APP_VERSION=0.2.0
DEBUG=true
# 必填。留空或保留占位值（change-me...）时后端拒绝启动 —— 占位密钥可被用来伪造任意用户 Token。
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
# 注意：轮换后所有已签发 Token 失效。
SECRET_KEY=
ENVIRONMENT=development

# ---------- Database ----------
# DATABASE_TYPE: "sqlite" (default) or "postgres"
DATABASE_TYPE=sqlite
# SQLite file path (relative to backend/)
# SQLite file path（相对路径按 backend/ 解析，不随启动目录漂移）
DATABASE_PATH=data/app.db

# PostgreSQL (only used when DATABASE_TYPE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_drama_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# ---------- Redis / Celery ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]

# ---------- Storage ----------
# STORAGE_TYPE: "local" (default) or "minio"
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=data/uploads

# MinIO (only used when STORAGE_TYPE=minio)
# 桶是**私有**的：所有访问都走预签名 URL（有效期见 MEDIA_URL_TTL_SECONDS），
# 不要再给桶手工加 public-read 策略，否则等于把全部素材和成片公开到公网。
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ai-drama-studio-assets
MINIO_USE_SSL=false
# 固定 region，避免 minio-py 为解析桶 region 额外发一次网络请求（在 async 路由里等于隐形阻塞）
MINIO_REGION=us-east-1
# 浏览器实际访问 MinIO 用的地址（host:port，不带协议）。容器里 MINIO_ENDPOINT 是
# minio:9000（浏览器解析不了），而 SigV4 签名覆盖 Host 头 —— 签名主机名必须等于
# 浏览器访问的主机名，否则预签名链接 403。留空表示与 MINIO_ENDPOINT 相同。
# docker-compose 默认 localhost:9000。
MINIO_PUBLIC_ENDPOINT=
# 对外地址用 https 时置 true（与 MINIO_USE_SSL 分开，内网明文、外网 TLS 的部署很常见）
MINIO_PUBLIC_USE_SSL=false

# ---------- AI Service APIs (Agnes AI) ----------
# Get your key at: https://platform.agnes-ai.com/settings/apiKeys
AGNES_API_KEY=
AGNES_API_BASE=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0

# ---------- Media / Auth limits (M1) ----------
# 媒体签名链接有效期（秒）。默认 6 小时；成片/素材链接过期后需重新拉接口取新链接。
MEDIA_URL_TTL_SECONDS=21600
# 同一 (客户端 IP, 用户名) 连续登录失败达到该次数即锁定
LOGIN_MAX_FAILURES=5
# 锁定时长（秒）
LOGIN_LOCKOUT_SECONDS=300
# 登录限流后端：auto=Redis 可达则用 Redis（多 worker 共享计数），否则降级进程内；
# redis=强制 Redis（不可用直接报错，生产建议）；memory=强制进程内（单机调试）
RATE_LIMIT_BACKEND=auto

# ---------- FFmpeg ----------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FORMAT=json